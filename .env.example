# Hosted Supabase project (required for Google OAuth and production auth).
# Dashboard → Settings → API → Project URL + anon public key.
# Next.js (Vercel): use NEXT_PUBLIC_* — Vite local dev can still use VITE_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Canonical site URL for production OAuth (must match Supabase Auth → URL Configuration).
# Vercel: set NEXT_PUBLIC_SITE_URL or VITE_SITE_URL to https://nextrends-ai.de
NEXT_PUBLIC_SITE_URL=https://nextrends-ai.de
VITE_SITE_URL=https://nextrends-ai.de

# Supabase Dashboard (Authentication → URL Configuration):
#   Site URL: https://nextrends-ai.de
#   Redirect URLs: https://nextrends-ai.de/auth/callback
#                    https://nextrends-ai.de/**
#                    http://localhost:5173/auth/callback  (local dev)
# Failed OAuth redirects to /login

# Do not use http://127.0.0.1:54321 for the frontend — local Supabase does not enable Google OAuth
# or hosted edge functions (hook-generator, generate-video, consume-credits).

# After changing env: npm run dev
# Deploy edge functions:
#   npm run deploy:hooks    # hook-generator + consume-credits
#   npm run deploy:video    # generate-video
# Verify: npm run verify:functions
